{
  "name": "examples",
  "browserslist": [
    "extends browserslist-config-baseline"
  ],
  "scripts": {
    "dev": "cross-env NODE_ENV=development rspack serve --config=rspack.config.js",
    "clean:prod": "rm -rf build && rm -rf dist && mkdir dist",
    "copy:index": "cp ./dist/index.html ../index.html && cp ./dist/index.html ../404.html",
    "build": "npm run clean:prod && npm run lint && npm run build:rspack && npm run copy:index",
    "git:commit": "cd .. && npm run git:commit",
    "git:push": "cd .. && npm run git:push",
    "git:commit:push": "cd .. && npm run git:commit:push",
    "git:merge:mirror": "cd .. && npm run git:merge:mirror",
    "reinstall": "npm run reinstall:module",
    "reinstall:module": "rm -rf node_modules && rm -f package-lock.json && npm i",
    "lint": "eslint src",
    "tsc": "npx tsc --noEmit",
    "pub": "cd .. && npm run pub",
    "build:rspack": "cross-env NODE_ENV=production rspack build --config rspack.config.js"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-react": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@eslint/js": "^9.39.5",
    "@mui/icons-material": "^7.3.6",
    "@mui/material": "^7.3.6",
    "@pdg/react-admin-layout": "^1.0.58",
    "@rspack/cli": "^2.3.0",
    "@rspack/core": "^2.3.0",
    "@rspack/dev-server": "^2.2.2",
    "@rspack/plugin-react-refresh": "^2.0.2",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/parser": "^8.72.1",
    "babel-loader": "^10.1.1",
    "babel-plugin-react-compiler": "1.0.0",
    "browserslist-config-baseline": "^0.5.0",
    "core-js": "^3.51.0",
    "cross-env": "^10.1.0",
    "eslint": "9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-rspack-plugin": "^5.0.1",
    "html-rspack-plugin": "^6.1.11",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-refresh": "^0.19.0",
    "react-router": "^8.5.1",
    "sass": "^1.107.1",
    "sass-loader": "^17.1.0",
    "simplebar-react": "^3.3.2",
    "styled-components": "^6.6.0",
    "ts-checker-rspack-plugin": "^1.7.2",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.72.1"
  },
  "allowScripts": {
    "esbuild": true,
    "fsevents": true,
    "core-js": true,
    "@parcel/watcher": true
  }
}
