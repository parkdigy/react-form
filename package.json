{
  "name": "@pdg/react-form",
  "title": "Typescript React Form Module",
  "description": "Typescript React Form Module",
  "version": "1.2.20",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.esm.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.esm.js",
      "require": "./dist/index.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/parkdigy/react-form.git",
    "baseUrl": "https://github.com/parkdigy/react-form"
  },
  "bugs": {
    "url": "https://github.com/parkdigy/react-form/issues"
  },
  "homepage": "https://github.com/parkdigy/react-form#readme",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "dev": "cd examples && npm run dev",
    "watchman:del": "watchman watch-del \"${PWD}\" ; watchman watch-project \"${PWD}\"",
    "build:examples": "cd examples && npm run build",
    "build": "npm run watchman:del && rollup -c --bundleConfigAsCjs",
    "git:commit": "node .git-commit.cjs",
    "git:push": "git push",
    "git:commit:push": "npm run git:commit && npm run git:push",
    "git:merge:mirror": "node .git-merge.cjs mirror main",
    "reset:gitignore": "git rm -r --cached . && git add .",
    "pub": "npm i && npm run build:examples && npm run build && npm publish --access=public && [ -f ./.git/hooks/pre-commit ] && rm ./.git/hooks/pre-commit || true",
    "lint": "eslint './src/**/*.{ts,tsx}'",
    "tsc": "tsc --noEmit",
    "reinstall": "npm run reinstall:module",
    "reinstall:module": "rm -rf node_modules && rm -f package-lock.json && npm i"
  },
  "author": "YOUNG CHUL PARK",
  "license": "MIT",
  "readmeFilename": "README.md",
  "keywords": [
    "util",
    "typescript",
    "javascript"
  ],
  "peerDependencies": {
    "@emotion/react": "^11.0.0",
    "@emotion/styled": "^11.0.0",
    "@mui/icons-material": "^7.0.0",
    "@mui/material": "^7.0.0",
    "@mui/x-date-pickers": "^7.0.0",
    "@pdg/react-component": "^1.1.17",
    "@pdg/react-hook": "^2.0.22",
    "@tinymce/miniature": "^6.0.0",
    "@tinymce/tinymce-react": "^6.0.0",
    "dayjs": "^1.11.19",
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0",
    "react-router": ">=7.6.0",
    "simplebar-react": "^3.0.0"
  },
  "dependencies": {
    "@pdg/compare": "^1.0.9",
    "@pdg/data": "^1.0.9",
    "@pdg/formatting": "^1.0.10",
    "@pdg/types": "^1.0.11",
    "classnames": "^2.5.1",
    "react-number-format": "^5.4.4",
    "react-resize-detector": "^12.3.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-react": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@eslint/js": "9.39.5",
    "@mui/icons-material": "^7.3.6",
    "@mui/material": "^7.3.6",
    "@mui/x-date-pickers": "^8.22.1",
    "@pdg/eslint-plugin-react-hook": "^1.0.5",
    "@pdg/react-component": "^1.1.19",
    "@pdg/react-hook": "^2.0.25",
    "@rollup/plugin-babel": "^7.1.0",
    "@rollup/plugin-commonjs": "29.0.3",
    "@rollup/plugin-eslint": "9.2.0",
    "@rollup/plugin-node-resolve": "16.0.3",
    "@tinymce/miniature": "^6.0.0",
    "@tinymce/tinymce-react": "^6.3.0",
    "@types/jest": "30.0.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@typescript-eslint/parser": "8.72.1",
    "babel-plugin-react-compiler": "1.0.0",
    "dayjs": "^1.11.19",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.4",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "^17.14.0",
    "jest": "30.5.2",
    "prettier": "3.9.10",
    "react-router": "^7.11.0",
    "rollup": "4.67.4",
    "rollup-plugin-delete": "3.0.2",
    "rollup-plugin-peer-deps-external": "2.2.4",
    "rollup-plugin-sass": "1.15.3",
    "rollup-plugin-typescript2": "0.37.0",
    "sass": "1.107.1",
    "simplebar-react": "^3.3.2",
    "ts-jest": "29.4.15",
    "ts-node": "10.9.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1"
  },
  "allowScripts": {
    "@parcel/watcher": true,
    "fsevents": true
  }
}
